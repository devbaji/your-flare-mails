# Local environment example (never commit real secrets)
# Copy to `.env` for local tooling (ingest fixtures, etc.)

# Shared HMAC secret for Worker → API ingest (local placeholder).
# Production: wrangler secret put INGEST_HMAC_SECRET (see docs/deploy.md)
INGEST_HMAC_SECRET=dev-ingest-hmac-secret-change-me

# Separate HMAC secret for short-lived attachment download tokens.
# Production: wrangler secret put BLOB_SIGNING_SECRET
BLOB_SIGNING_SECRET=dev-blob-signing-secret-change-me

# Base URL of the ingest API (local wrangler dev for workers/api)
INGEST_URL=http://127.0.0.1:8787

# Optional envelope overrides for pnpm ingest:fixture
# ENVELOPE_TO=hello@example.com
# ENVELOPE_FROM=alice@example.com

# Browser origins allowed for credentialed CORS (comma-separated)
# CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Emergency only: re-enable spoofable x-yfm-user-id / ?userId=
# ALLOW_DEV_USER_HEADER=true

# Optional Cloudflare Access alternate auth (personal deployments)
# CF_ACCESS_TEAM_DOMAIN=https://example.cloudflareaccess.com
# CF_ACCESS_AUD=your-access-application-aud

# Seed login (after pnpm db:seed): owner@example.com / owner-dev-password

# Production hostnames / D1 IDs live in config/deploy.local.env (gitignored).
# See config/deploy.example.env and docs/deploy.md

# Display name for local web/desktop (override; deploy.local.env wins for builds)
# YFM_BRAND_NAME=Your Flare Mails
# NUXT_PUBLIC_YFM_BRAND_NAME=Your Flare Mails

# Push (Phase 10) — leave FORCE_MOCK_PUSH=true for local mock delivery
# FORCE_MOCK_PUSH=true
# For production Android notifications: FORCE_MOCK_PUSH=false + wrangler secret:
#   FCM_SERVICE_ACCOUNT_JSON=<firebase service account JSON>
# APNS_TEAM_ID=
# APNS_KEY_ID=
# APNS_PRIVATE_KEY_PEM=
# APNS_BUNDLE_ID=com.yourflaremails.desktop
# APNS_PRODUCTION=false
# FCM_SERVICE_ACCOUNT_JSON=
