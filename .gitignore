# Dependencies
node_modules/

# Build / framework outputs
dist/
build/
.nuxt/
.output/
.nitro/
.wrangler/
infra/.wrangler/
workers/*/.wrangler/
.turbo/
*.tsbuildinfo

# Env / secrets
.env
.env.*
!.env.example
.dev.vars
**/.dev.vars

# Local deploy overlays (generated / personal — never commit)
config/deploy.local.env
**/wrangler.deploy.jsonc
apps/web/.env.production.local
infra/seed/seed-prod.sql

# Android release signing (never commit)
apps/desktop/android-release.keystore
apps/desktop/*.keystore
apps/desktop/*.jks
apps/desktop/android-keystore.properties

# Wrangler auth / local caches (also covered by .wrangler/)
.wrangler/state/

# Test / coverage
coverage/
.nyc_output/

# IDE / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc
*.local
.cache/
tmp/
temp/
