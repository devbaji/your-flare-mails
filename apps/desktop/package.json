{
  "name": "@your-flare-mails/desktop",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "YourFlareMails Tauri 2 desktop shell",
  "scripts": {
    "dev": "node ./scripts/with-brand-env.mjs tauri dev",
    "build": "node ./scripts/with-brand-env.mjs tauri build",
    "build:android": "node ./scripts/with-brand-env.mjs tauri android build --apk --target aarch64",
    "sign:android": "bash ./scripts/sign-apk.sh",
    "tauri": "node ./scripts/with-brand-env.mjs tauri",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "echo 'desktop lint: Rust checked via cargo; no JS eslint surface'",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-notification": "^2.3.0",
    "tauri-plugin-mobile-push-api": "^0.1.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "@types/node": "^22.20.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
