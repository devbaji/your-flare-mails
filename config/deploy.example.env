# Copy to config/deploy.local.env and fill in (gitignored).
# Never put HMAC secrets or passwords here — use `wrangler secret put`.

# Cloudflare resource IDs (from `wrangler d1 create` / dashboard)
D1_DATABASE_ID=00000000-0000-0000-0000-000000000001
R2_BUCKET_NAME=your-flare-mails-attachments

# Public hostnames (must be on a Cloudflare zone you control)
WEB_HOSTNAME=mail.example.com
API_HOSTNAME=api.example.com

# Mailbox bootstrap (used when writing infra/seed/seed-prod.sql)
MAIL_DOMAIN=example.com
MAILBOX_ADDRESS=hello@example.com
OWNER_EMAIL=owner@example.com
# Hash passwords with:
#   pnpm --filter @your-flare-mails/infra run hash-password -- 'your-password'

# Browser origin for API CORS (usually https://WEB_HOSTNAME)
CORS_ORIGINS=https://mail.example.com

# Nuxt production build — must match API_HOSTNAME
NUXT_PUBLIC_API_BASE_URL=https://api.example.com

# Optional overrides written into wrangler.deploy.jsonc
FORCE_MOCK_TRANSPORT=true
# Set false once FCM_SERVICE_ACCOUNT_JSON (and/or APNs secrets) are configured
FORCE_MOCK_PUSH=true

# Push secrets are NOT written into wrangler.deploy.jsonc — set via:
#   cd workers/api && pnpm exec wrangler secret put FCM_SERVICE_ACCOUNT_JSON --config wrangler.deploy.jsonc
# Paste the full Firebase service-account JSON when prompted.
# Optional iOS:
#   wrangler secret put APNS_TEAM_ID / APNS_KEY_ID / APNS_PRIVATE_KEY_PEM / APNS_BUNDLE_ID
#   wrangler secret put APNS_PRODUCTION   # "true" for App Store / TestFlight

# Inbound Email Worker — forward copies to Email Routing *verified* destinations
# (comma-separated). Forwards are best-effort; ingest into the app always runs after.
# FORWARD_BACKUP_ENABLED=true
# FORWARD_BACKUP_ADDRESSES=you@gmail.com,backup@example.com
